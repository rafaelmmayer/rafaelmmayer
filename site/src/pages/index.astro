---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const formatShort = (date: Date) =>
  date.toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' }).replace('.', '');

const writings = (await getCollection('artigos', ({ data }) => data.published !== false))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const projects = (await getCollection('projetos', ({ data }) => data.published !== false))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 3);
---

<BaseLayout>
  <main>
    <section class="hero">
      <h1>Oi, eu sou o Rafael.</h1>
      <p class="lead">
        Trabalho com software, engenharia e infraestrutura. Uso este site para registrar projetos,
        escrever sobre decisões técnicas e organizar algumas ideias fora do trabalho.
      </p>
    </section>

    <section class="section" id="sobre">
      <p class="section-label">sobre</p>
      <p>
        Trabalho no
        <a href="https://optype.com.br" target="_blank" rel="noreferrer">Optype</a>, onde cuido
        de produto e tecnologia em uma plataforma para estudos estruturais. Antes disso, liderei
        softwares internos na RM, com ferramentas de engenharia, automações Revit e sistemas para
        o trabalho técnico das equipes.
      </p>
      <p>
        Me interessam os pontos onde software encontra engenharia: modelos, cálculos, arquivos
        técnicos e decisões que precisam continuar fazendo sentido depois que o código está em
        produção.
      </p>
      <p>
        Fora do trabalho, passo um bom tempo mexendo em open source, homelab, self-hosting e
        ferramentas que rodam por aqui. Também escrevo sobre política, visão de mundo e outras
        coisas que não cabem direito em uma apresentação profissional.
      </p>
    </section>

    <section class="section">
      <p class="section-label">agora</p>
      <p>
        Meu foco agora está no
        <a href="https://optype.com.br/" target="_blank" rel="noreferrer">Optype</a>: seguir
        amadurecendo a plataforma, tomar decisões técnicas com menos pressa e construir o produto
        junto com o time.
      </p>
      <p>
        Fora dali, sigo mexendo no homelab, publicando alguns projetos pessoais e escrevendo
        sobre o que vou aprendendo no caminho.
      </p>
      <p class="now-stamp">atualizado em junho de 2026</p>
    </section>

    <section class="section" id="projetos">
      <p class="section-label">projetos</p>
      <p>
        Algumas coisas que venho construindo ou mantendo. Tem produto, ferramenta interna,
        automação, infraestrutura de casa e experimento que valeu registrar.
      </p>

      {projects.length > 0 ? (
        <ul class="index-list">
          {projects.map((project) => (
            <li class="entry">
              <span class="date">{project.data.status ?? '—'}</span>
              <div class="body">
                <h3><a href={`/projetos/${project.id}/`}>{project.data.title}</a></h3>
                <p>{project.data.description}</p>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <div class="note">Os primeiros projetos ainda vão aparecer por aqui.</div>
      )}

      <p class="inline-links" style="margin-top:1.25rem">
        <a href="/projetos/">ver projetos →</a>
      </p>
    </section>

    <section class="section" id="artigos">
      <p class="section-label">artigos</p>
      <p>
        Textos para organizar pensamento sobre engenharia, software, infraestrutura e outras
        coisas que não cabem bem em uma conversa rápida.
      </p>

      {writings.length > 0 ? (
        <ul class="index-list">
          {writings.map((post) => (
            <li class="entry">
              <span class="date">{formatShort(post.data.date)}</span>
              <div class="body">
                <h3><a href={`/artigos/${post.id}/`}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <div class="note">Os primeiros textos ainda vão aparecer por aqui.</div>
      )}

      <p class="inline-links" style="margin-top:1.25rem">
        <a href="/artigos/">ver tudo →</a>
      </p>
    </section>

    <section class="section" id="contato">
      <p class="section-label">contato</p>
      <p>
        Se quiser trocar ideia, me chama por
        <a href="mailto:mayer.rafa@outlook.com">e-mail</a>
        <span class="sep">·</span>
        <a href="https://www.linkedin.com/in/rafaelmmayer/" target="_blank" rel="noreferrer">linkedin</a>
        <span class="sep">·</span>
        <a href="https://github.com/rafaelmmayer/rafaelmmayer" target="_blank" rel="noreferrer">github</a>.
      </p>
    </section>
  </main>
</BaseLayout>
