---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projetos', ({ data }) => data.published !== false);

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const formatLongDate = (date: Date) => date.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const projectMeta: string[] = [];

if (project.data.date) {
  projectMeta.push(`publicado em ${formatLongDate(project.data.date)}`);
}

if (project.data.updated && (!project.data.date || project.data.updated.getTime() > project.data.date.getTime())) {
  projectMeta.push(`atualizado em ${formatLongDate(project.data.updated)}`);
}

if (project.data.tags?.length) {
  projectMeta.push(project.data.tags.join(' · '));
}
---

<BaseLayout title={`${project.data.title} — Rafael Mayer`} description={project.data.description}>
  <article class="prose">
    <a class="back" href="/projetos/">← projetos</a>
    <p class="kicker">{project.data.status ?? 'projeto'}</p>
    <h1>{project.data.title}</h1>
    <p class="lead">{project.data.description}</p>
    {projectMeta.length ? (
      <p class="post-meta">{projectMeta.join(' · ')}</p>
    ) : null}
    <Content />
  </article>
</BaseLayout>
