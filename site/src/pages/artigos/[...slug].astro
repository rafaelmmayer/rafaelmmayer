---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('artigos', ({ data }) => data.published !== false);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formatLongDate = (date: Date) => date.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const formattedDate = formatLongDate(post.data.date);
const showUpdated = post.data.updated && post.data.updated.getTime() > post.data.date.getTime();
const postMeta = [`publicado em ${formattedDate}`];

if (showUpdated && post.data.updated) {
  postMeta.push(`atualizado em ${formatLongDate(post.data.updated)}`);
}

if (post.data.tags?.length) {
  postMeta.push(post.data.tags.join(' · '));
}

const articleGroup = (id: string) => {
  const [group] = id.split('/');
  if (!id.includes('/')) return null;

  return group
    .split('-')
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');
};

const group = articleGroup(post.id);
---

<BaseLayout title={`${post.data.title} — Rafael Mayer`} description={post.data.description}>
  <article class="prose">
    <a class="back" href="/artigos/">← artigos</a>
    <p class="kicker">{post.data.type ?? 'artigo'}</p>
    <h1>{post.data.title}</h1>
    <p class="lead">{post.data.description}</p>
    <p class="post-meta">{postMeta.join(' · ')}</p>
    {group ? (
      <p class="series-meta">série: {group}{post.data.order ? ` · parte ${post.data.order}` : ''}</p>
    ) : null}
    <Content />
  </article>
</BaseLayout>
